from python_files.Preprocess import load_pickle_file
import numpy as np
import pandas as pd

data = load_pickle_file('./data/data.pkl')


from python_files.automl import AutoMlMultiLabelClassifier
from sklearn.model_selection import train_test_split

# X = data['X']
